{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // The widget shares the server's facet vocabulary (src/facets.ts) instead of
  // keeping a copy that drifts; it lives outside this directory, so it has to
  // be pulled into the program explicitly.
  "include": ["./**/*.ts", "../src/facets.ts"]
}
