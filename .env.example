# Copy to .env — docker compose reads it automatically. Everything is optional.

# Stateless mode: no sessions, nothing lost on restart, no 100-session cap.
# Recommended for LibreChat and other hosts that show no interactive widget.
MCP_STATELESS=false

# Require "Authorization: Bearer <token>" on /mcp. Leave empty for an open endpoint
# (needed for claude.ai custom connectors, which cannot send a static header).
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Requests per minute and MCP session. In stateless mode every client behind one
# IP shares the budget (LibreChat = all of its users), so raise it there.
RATE_LIMIT_PER_MINUTE=60

# Browser origins allowed to call /mcp, comma-separated. Leave empty: LibreChat,
# claude.ai and hosted platforms call from a backend and send no Origin header.
ALLOWED_ORIGINS=

# Host port for the localhost binding of docker-compose.yml.
HOST_PORT=3000
